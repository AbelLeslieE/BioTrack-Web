# Required: set a unique random value of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters

# Session lifetime in minutes. Use COOKIE_SECURE=true when serving HTTPS.
JWT_EXPIRY_MINUTES=480
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=false

# Production browser security. Production startup rejects insecure settings.
# ENVIRONMENT=production
# PUBLIC_ORIGIN=https://biotrack.example.org
# ALLOWED_HOSTS=biotrack.example.org
# FORCE_HTTPS=true
# TRUST_PROXY_HEADERS=true

# MFA is optional and can be enabled by each user from Settings > Security.
MFA_ISSUER=BioTrack
# Keep this stable across JWT rotations. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEY=

# Login throttling (persistent account lockout is also enforced).
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_MAX_ATTEMPTS=20

# Attachment malware scanning. Point these at a ClamAV daemon in production.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SCAN_REQUIRED=false

# Recommended production setup: use the Neon pooled URL for application
# traffic and the direct URL for migrations. Never commit either value.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Optional paid Render-disk setup for SQLite or legacy disk files. PostgreSQL-
# backed uploads do not require it.
# BIOTRACK_DATA_DIR=/var/data

# Optional first-run administrator bootstrap. These are consumed only when no users exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
