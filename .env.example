# Required: generate a unique random value of at least 32 characters.
JWT_SECRET_KEY=147852369852147852369852147852136

# Session lifetime in minutes. Use COOKIE_SECURE=true when serving HTTPS.
JWT_EXPIRY_MINUTES=480
COOKIE_SECURE=false

# Optional first-run administrator bootstrap. These are consumed only when no users exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
